digraph PetStore_ER {
    // ===== 全局设置 =====
    rankdir=LR;
    fontname="Microsoft YaHei";
    node [fontname="Microsoft YaHei", fontsize=10];
    edge [fontname="Microsoft YaHei", fontsize=9];
    splines=polyline;
    nodesep=0.6;
    ranksep=1.2;
    dpi=150;

    // ===== 实体（矩形，HTML表格样式） =====
    node [shape=plaintext, fontsize=10];

    // 用户
    user [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2" BGCOLOR="#4472C4"><FONT COLOR="white"><B>用户</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>用户号</U></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">用户名</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">密码</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">性别</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">邮箱</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">电话</TD><TD></TD></TR>
    </TABLE>
    >];

    // 商品分类
    category [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2" BGCOLOR="#4472C4"><FONT COLOR="white"><B>商品分类</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>分类编号</U></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">分类名称</TD><TD></TD></TR>
    </TABLE>
    >];

    // 商品
    product [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2" BGCOLOR="#4472C4"><FONT COLOR="white"><B>商品</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>商品编号</U></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">商品名</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">商品介绍</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">市场价格</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">当前价格</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">数量</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">分类编号</TD><TD ALIGN="LEFT">FK</TD></TR>
    </TABLE>
    >];

    // 购物车
    cart [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2" BGCOLOR="#4472C4"><FONT COLOR="white"><B>购物车</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>购物车编号</U></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">用户号</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">商品编号</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">数量</TD><TD></TD></TR>
    </TABLE>
    >];

    // 订单
    order [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2" BGCOLOR="#4472C4"><FONT COLOR="white"><B>订单</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>订单号</U></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">用户号</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">订单日期</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">订单总价</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">是否已处理</TD><TD></TD></TR>
    </TABLE>
    >];

    // 订单明细
    order_detail [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD COLSPAN="2" BGCOLOR="#4472C4"><FONT COLOR="white"><B>订单明细</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>明细编号</U></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">订单号</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">商品编号</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">商品名</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">单价</TD><TD></TD></TR>
      <TR><TD ALIGN="LEFT">数量</TD><TD></TD></TR>
    </TABLE>
    >];

    // ===== 联系（菱形） =====
    node [shape=diamond, style=filled, fillcolor="#ED7D31", fontsize=9, height=0.4, width=0.7];

    rel_contain [label="包含"];
    rel_add [label="添加"];
    rel_join [label="被加入"];
    rel_place [label="下达"];
    rel_own [label="拥有"];
    rel_correspond [label="对应"];

    // ===== 关系连线 =====
    // 商品分类 1:N 商品
    edge [color="#333333", penwidth=1.2];
    category -> rel_contain [dir=none];
    rel_contain -> product [dir=none];
    { rank=same; category; rel_contain; product }

    // 用户 1:N 购物车
    edge [color="#333333", penwidth=1.2];
    user -> rel_add [dir=none];
    rel_add -> cart [dir=none];

    // 商品 1:N 购物车
    product -> rel_join [dir=none];
    rel_join -> cart [dir=none];

    // 用户 1:N 订单
    user -> rel_place [dir=none];
    rel_place -> order [dir=none];

    // 订单 1:N 订单明细
    order -> rel_own [dir=none];
    rel_own -> order_detail [dir=none];

    // 商品 1:N 订单明细
    product -> rel_correspond [dir=none];
    rel_correspond -> order_detail [dir=none];

    // ===== 基数标注 =====
    node [shape=plaintext, fontsize=8, fontcolor="#666666"];

    // 商品分类-商品
    n_label1 [label="N"];
    { rank=same; rel_contain; n_label1; }
    // 用户-购物车
    n_label2 [label="N"];
    // 商品-购物车
    n_label3 [label="N"];
    // 用户-订单
    n_label4 [label="N"];
    // 订单-订单明细
    n_label5 [label="N"];
    // 商品-订单明细
    n_label6 [label="N"];

    // 基数1标签
    one_label1 [label="1"];

    // 等级分组（垂直对齐）
    { rank=same; user; }
    { rank=same; rel_add; cart; }
    { rank=same; rel_place; order; }
}
